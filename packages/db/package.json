{
  "name": "@tcl-kol-os/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Acceso a datos y migraciones. Aplica las políticas de packages/domain; no las redefine (ADR-008).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-utils": "./src/test-utils.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@tcl-kol-os/domain": "*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
