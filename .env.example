# ─────────────────────────────────────────────────────────────────────────────
# TCL KOL OS — plantilla de configuración
#
# Copie este archivo a `.env` y complete los valores:
#     cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio (§27).
# Este archivo no contiene secretos reales: solo nombres, formatos y valores
# de desarrollo (§12.1, control 5).
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
NODE_ENV=development
LOG_LEVEL=INFO

# ── Puertos expuestos en la máquina ──────────────────────────────────────────
WEB_PORT=3000
WORKER_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Base de datos ────────────────────────────────────────────────────────────
# Fuente de verdad del dominio, la auditoría y los embeddings.
POSTGRES_USER=tclkolos
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=tclkolos
DATABASE_URL=postgresql://tclkolos:devpassword@localhost:5432/tclkolos

# ── Cola y caché ─────────────────────────────────────────────────────────────
# ADR-007: Redis solo contiene trabajo en tránsito. Perderlo no pierde
# información de negocio.
REDIS_URL=redis://localhost:6379/0

# ── Comunicación entre servicios ─────────────────────────────────────────────
WORKER_URL=http://localhost:8000

# ── Procesamiento documental (DEC-010) ───────────────────────────────────────
# Formatos soportados: PDF, PPTX, DOCX, PNG, JPG.
MAX_UPLOAD_MB=50

# ── Inteligencia artificial ──────────────────────────────────────────────────
# Épica E11-9 — interruptor de IA.
# Con AI_ENABLED=false el sistema opera en modo manual: se puede crear, editar,
# versionar, aprobar y exportar un brief sin ninguna llamada a un modelo.
# Esta es la configuración por defecto durante el Sprint 0.
AI_ENABLED=false

# Proveedor de IA. Obligatorio solo si AI_ENABLED=true.
# El adaptador aísla la elección (ADR-001, D0-09 §4.1): cambiarlo no exige
# tocar la lógica de dominio.
AI_PROVIDER=
AI_API_KEY=

# ── Identidad (Épica E2 — Sprint 1) ──────────────────────────────────────────
# OIDC contra el Google Workspace de SmartPR.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Dominio autorizado: solo cuentas de este dominio pueden iniciar sesión.
OIDC_ALLOWED_DOMAIN=

# ── Google Drive (Épica E4 — Sprint 2) ───────────────────────────────────────
# DEC-006: cuenta de servicio con delegación a nivel de dominio, restringida al
# Drive de campañas. NUNCA credenciales personales de un usuario.
# Ruta al JSON de la cuenta de servicio; el archivo va fuera del repositorio.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Storage de derivados (Épica E4 — Sprint 2) ───────────────────────────────
# S3 compatible. Guarda previews, exportaciones y temporales: todo regenerable.
# En local puede usarse MinIO.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Observabilidad (Épica E12 — Sprint 7) ────────────────────────────────────
# Los logs nunca contienen prompts, tokens ni PII (§11.6, caso S-10).
SENTRY_DSN=
