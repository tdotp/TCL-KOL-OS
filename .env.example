# ─────────────────────────────────────────────────────────────────────────────
# TCL KOL OS — plantilla de configuración
#
# Copie este archivo a `.env` y complete los valores:
#     cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio (§27).
# Este archivo no contiene secretos reales: solo nombres, formatos y valores
# de desarrollo (§12.1, control 5).
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
# development | staging | production
# NODE_ENV no se declara aquí: Next.js lo fija por comando
# (development en `next dev`, production en `next build`). Declararlo
# manualmente rompe el build.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Puertos expuestos en la máquina ──────────────────────────────────────────
WEB_PORT=3000
WORKER_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Base de datos ────────────────────────────────────────────────────────────
# Fuente de verdad del dominio, la auditoría y los embeddings.
POSTGRES_USER=tclkolos
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=tclkolos
DATABASE_URL=postgresql://tclkolos:devpassword@localhost:5432/tclkolos

# Base APARTE para `npm test --workspace @tcl-kol-os/db` (INC-001A). El nombre
# debe terminar en "_test": packages/db/vitest.setup.ts se niega a arrancar si
# no lo hace, precisamente para que la suite nunca pueda tocar la base de
# arriba por error. Créela una vez con:
#   docker exec tclkolos-db psql -U tclkolos -d postgres -c "CREATE DATABASE tclkolos_test"
#   docker exec tclkolos-db psql -U tclkolos -d tclkolos_test -f /docker-entrypoint-initdb.d/01-extensions.sql
#   DATABASE_URL=postgresql://tclkolos:devpassword@localhost:5432/tclkolos_test npm run migrate --workspace @tcl-kol-os/db
#   DATABASE_URL=postgresql://tclkolos:devpassword@localhost:5432/tclkolos_test npm run seed --workspace @tcl-kol-os/db
TEST_DATABASE_URL=postgresql://tclkolos:devpassword@localhost:5432/tclkolos_test

# ── Cola y caché ─────────────────────────────────────────────────────────────
# ADR-007: Redis solo contiene trabajo en tránsito. Perderlo no pierde
# información de negocio.
REDIS_URL=redis://localhost:6379/0

# ── Comunicación entre servicios ─────────────────────────────────────────────
WORKER_URL=http://localhost:8000

# ── Procesamiento documental (DEC-010) ───────────────────────────────────────
# Formatos soportados: PDF, PPTX, DOCX, PNG, JPG.
MAX_UPLOAD_MB=50

# ── Inteligencia artificial ──────────────────────────────────────────────────
# Épica E11-9 — interruptor de IA.
# Con AI_ENABLED=false el sistema opera en modo manual: se puede crear, editar,
# versionar, aprobar y exportar un brief sin ninguna llamada a un modelo.
# Esta es la configuración por defecto durante el Sprint 0.
AI_ENABLED=false

# Proveedor de IA. Obligatorio solo si AI_ENABLED=true.
# El adaptador aísla la elección (ADR-001, D0-09 §4.1): cambiarlo no exige
# tocar la lógica de dominio.
AI_PROVIDER=openrouter

# Clave de OpenRouter. NUNCA se escribe aquí ni se sube al repositorio:
# va en el archivo .env local, que está en .gitignore.
AI_API_KEY=

# ── Niveles de modelo (DEC-019) ──────────────────────────────────────────────
# La tabla §9.2 del documento maestro asigna un NIVEL a cada tarea; aquí se
# decide qué modelo atiende cada nivel. Sin valores por defecto a propósito: un
# modelo que aparece porque nadie configuró nada acabaría en producción sin que
# nadie lo hubiera decidido.
#
# Qué modelo merece cada nivel se decide midiendo, no opinando:
#     python scripts/validar_niveles.py --modelos "a,b,c"
#
# eficiente   → extracción, traducción, búsqueda de evidencia (alto volumen)
# equilibrado → detección de vacíos, redacción del brief
# avanzado    → resolver ambigüedad; §9.2 dice "solo si aporta"
# Valores medidos el 12 de agosto de 2026 contra el gold set.
# Evidencia: docs/product/D0-13-validacion-niveles.md
AI_MODEL_EFICIENTE=google/gemini-2.5-flash-lite
AI_MODEL_EQUILIBRADO=anthropic/claude-haiku-4.5
AI_MODEL_AVANZADO=anthropic/claude-sonnet-5

# Embeddings para la búsqueda vectorial (§9.3). OpenRouter los sirve en el
# mismo endpoint, así que no hace falta un segundo proveedor.
# 1536 dimensiones: coincide con la columna vector(1536) ya creada.
AI_MODEL_EMBEDDINGS=openai/text-embedding-3-small

# URL de la aplicación, para la atribución de tráfico en OpenRouter.
AI_APP_URL=https://smartpr.co

# ── Identidad (Épica E2 — Sprint 1) ──────────────────────────────────────────
# Proveedor de identidad conmutable:
#   dev  → selección de usuario sembrado; solo para desarrollo
#   oidc → Google Workspace, requiere las credenciales de abajo
AUTH_PROVIDER=dev

# Firma de la cookie de sesión. Obligatorio en producción.
SESSION_SECRET=

# OIDC contra el Google Workspace de SmartPR.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Dominio autorizado: solo cuentas de este dominio pueden iniciar sesión.
OIDC_ALLOWED_DOMAIN=

# ── Google Drive (Épica E4 — Sprint 2) ───────────────────────────────────────
# DEC-006: cuenta de servicio con delegación a nivel de dominio, restringida al
# Drive de campañas. NUNCA credenciales personales de un usuario.
# Ruta al JSON de la cuenta de servicio; el archivo va fuera del repositorio.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Almacenamiento del original (Épica E4) ───────────────────────────────────
# El original se conserva íntegro y nunca se modifica. En desarrollo va al
# sistema de archivos; en Drive cuando DEC-006 esté conectado.
STORAGE_LOCAL_PATH=./.storage

# ── Storage de derivados (Épica E4 — Sprint 2) ───────────────────────────────
# S3 compatible. Guarda previews, exportaciones y temporales: todo regenerable.
# En local puede usarse MinIO.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Observabilidad (Épica E12 — Sprint 7) ────────────────────────────────────
# Los logs nunca contienen prompts, tokens ni PII (§11.6, caso S-10).
SENTRY_DSN=
