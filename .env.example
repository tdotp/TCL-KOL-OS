# ─────────────────────────────────────────────────────────────────────────────
# TCL KOL OS — plantilla de configuración
#
# Copie este archivo a `.env` y complete los valores:
#     cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio (§27).
# Este archivo no contiene secretos reales: solo nombres, formatos y valores
# de desarrollo (§12.1, control 5).
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
# development | staging | production
# NODE_ENV no se declara aquí: Next.js lo fija por comando
# (development en `next dev`, production en `next build`). Declararlo
# manualmente rompe el build.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Puertos expuestos en la máquina ──────────────────────────────────────────
WEB_PORT=3000
WORKER_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Base de datos ────────────────────────────────────────────────────────────
# Fuente de verdad del dominio, la auditoría y los embeddings.
#
# Tres roles (Release Readiness · Bloque 1; detalle en docs/project/RELEASE_HARDENING.md):
#   · POSTGRES_USER     administrador de ARRANQUE (superusuario del contenedor). Solo crea roles/bases/extensiones.
#                       Ninguna aplicación lo usa.
#   · DB_MIGRATOR_USER  dueño del esquema; ejecuta `npm run migrate`. Sin SUPERUSER.
#   · DB_APP_USER       rol de EJECUCIÓN de web, worker y consumidor: solo SELECT/INSERT/UPDATE/DELETE.
#                       Sin SUPERUSER, sin propiedad de tablas, sin TRUNCATE, sin DDL.
# Las contraseñas de abajo son de DESARROLLO. Fuera de local se generan y se guardan en el gestor de secretos.
POSTGRES_USER=tclkolos
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=tclkolos
DB_MIGRATOR_USER=tclkolos_migrator
DB_MIGRATOR_PASSWORD=devmigrator
DB_APP_USER=tclkolos_app
DB_APP_PASSWORD=devapp
# Rol de EJECUCIÓN (la aplicación). Nunca el administrador.
DATABASE_URL=postgresql://tclkolos_app:devapp@localhost:5432/tclkolos
# Rol MIGRADOR: solo para `npm run migrate` (si falta, migrate usa DATABASE_URL).
MIGRATION_DATABASE_URL=postgresql://tclkolos_migrator:devmigrator@localhost:5432/tclkolos

# Base APARTE para `npm test --workspace @tcl-kol-os/db` (INC-001A). El nombre
# debe terminar en "_test": packages/db/vitest.setup.ts se niega a arrancar si
# no lo hace, precisamente para que la suite nunca pueda tocar la base de
# arriba por error. Se prepara con el script de bootstrap (crea la base, las
# extensiones, el dueño y el rol de ejecución) y luego se migra y se siembra:
#   ADMIN_URL=postgresql://tclkolos:devpassword@localhost:5432 DB_MIGRATOR_PASSWORD=devmigrator DB_APP_PASSWORD=devapp \
#     scripts/db-bootstrap.sh tclkolos_test --crear
#   MIGRATION_DATABASE_URL=postgresql://tclkolos_migrator:devmigrator@localhost:5432/tclkolos_test \
#     DATABASE_URL=postgresql://tclkolos_app:devapp@localhost:5432/tclkolos_test npm run migrate --workspace @tcl-kol-os/db
#   DATABASE_URL=postgresql://tclkolos_app:devapp@localhost:5432/tclkolos_test npm run seed --workspace @tcl-kol-os/db
# Las pruebas corren con el rol de EJECUCIÓN (el mismo de producción: solo DML), no con el administrador.
TEST_DATABASE_URL=postgresql://tclkolos_app:devapp@localhost:5432/tclkolos_test
# Conexión PRIVILEGIADA solo para pruebas (inyectar fallos con triggers, probar la capa de triggers por debajo de los
# privilegios, crear bases clon). El código de producción nunca la usa.
TEST_ADMIN_DATABASE_URL=postgresql://tclkolos:devpassword@localhost:5432/tclkolos_test

# ── Cabeceras de seguridad (solo producción; ver docs/project/RELEASE_HARDENING.md) ──
# HSTS se emite SOLO en producción, sobre HTTPS (directo o `X-Forwarded-Proto: https` de un proxy TLS que conserve
# `Host`) y nunca en localhost. Sin valores: 180 días, sin includeSubDomains ni preload.
#   HSTS_MAX_AGE=15552000            segundos; 0 lo apaga. Súbalo (31536000) cuando TLS esté verificado.
#   HSTS_INCLUDE_SUBDOMAINS=false    "true" solo si TODOS los subdominios sirven HTTPS.
#   HSTS_PRELOAD=false               "true" exige includeSubDomains y max-age ≥ 31536000; compromete al dominio.
# Un valor inválido impide arrancar (`next build` / `next start`).

# ── Brief Workspace guiado (Sprint 6) ───────────────────────────────────────
# Apagada o ausente: /campanas/[id]/brief/workspace reenvía a /brief/editar,
# el flujo anterior queda intacto. En "true" activa el completado guiado.
BRIEF_WORKSPACE_V2=false

# ── Cola y caché ─────────────────────────────────────────────────────────────
# ADR-007: Redis solo contiene trabajo en tránsito. Perderlo no pierde
# información de negocio.
REDIS_URL=redis://localhost:6379/0

# ── Comunicación entre servicios ─────────────────────────────────────────────
# URL del worker. Opcional AI_WORKER_URL: si está definida gana sobre WORKER_URL
# (extracción, análisis de contenido y chat la leen en ese orden). /api/ready solo lee WORKER_URL.
WORKER_URL=http://localhost:8000

# ── Procesamiento documental (DEC-010) ───────────────────────────────────────
# Formatos soportados: PDF, PPTX, DOCX, PNG, JPG.
MAX_UPLOAD_MB=50

# ── Inteligencia artificial ──────────────────────────────────────────────────
# Épica E11-9 — interruptor de IA.
# Con AI_ENABLED=false el sistema opera en modo manual: se puede crear, editar,
# versionar, aprobar y exportar un brief sin ninguna llamada a un modelo.
# Esta es la configuración por defecto durante el Sprint 0.
AI_ENABLED=false

# Proveedor de IA. Obligatorio solo si AI_ENABLED=true.
# El adaptador aísla la elección (ADR-001, D0-09 §4.1): cambiarlo no exige
# tocar la lógica de dominio.
AI_PROVIDER=openrouter

# Clave de OpenRouter. NUNCA se escribe aquí ni se sube al repositorio:
# va en el archivo .env local, que está en .gitignore.
AI_API_KEY=

# ── Niveles de modelo (DEC-019) ──────────────────────────────────────────────
# La tabla §9.2 del documento maestro asigna un NIVEL a cada tarea; aquí se
# decide qué modelo atiende cada nivel. Sin valores por defecto a propósito: un
# modelo que aparece porque nadie configuró nada acabaría en producción sin que
# nadie lo hubiera decidido.
#
# Qué modelo merece cada nivel se decide midiendo, no opinando:
#     python scripts/validar_niveles.py --modelos "a,b,c"
#
# eficiente   → extracción, traducción, búsqueda de evidencia (alto volumen)
# equilibrado → detección de vacíos, redacción del brief
# avanzado    → resolver ambigüedad; §9.2 dice "solo si aporta"
# Valores medidos el 12 de agosto de 2026 contra el gold set.
# Evidencia: docs/product/D0-13-validacion-niveles.md
AI_MODEL_EFICIENTE=google/gemini-2.5-flash-lite
AI_MODEL_EQUILIBRADO=anthropic/claude-haiku-4.5
AI_MODEL_AVANZADO=anthropic/claude-sonnet-5

# Embeddings para la búsqueda vectorial (§9.3). OpenRouter los sirve en el
# mismo endpoint, así que no hace falta un segundo proveedor.
# 1536 dimensiones: coincide con la columna vector(1536) ya creada.
AI_MODEL_EMBEDDINGS=openai/text-embedding-3-small

# URL de la aplicación, para la atribución de tráfico en OpenRouter.
AI_APP_URL=https://smartpr.co

# ── Chat del agente de Cuenta (V2 · Fase 6) ──────────────────────────────────
# El chat vive en /campanas/[id]/chat (roles admin, director y consultor). La web
# ejecuta el bucle del agente y sus tools COMO la persona; cada vuelta de modelo es
# una llamada a WORKER_URL/modelo/turno (el worker es el único que habla con el
# proveedor y el único que ve AI_API_KEY). Con AI_ENABLED=false el chat se muestra
# pero no responde; no hay otro flag.
#
# Para desarrollo/CI sin clave ni saldo: AI_PROVIDER=fake (en el worker Y en la web) y
# AI_ENABLED=true. El modelo falso es determinista y obedece a un último mensaje del
# usuario con la forma `[[fake:tool nombre {json}]]` (ver services/ai-worker/app/ai/fake_provider.py).
#
# AI_PROVIDER / AI_MODEL_EQUILIBRADO (arriba) también los lee la web, pero SOLO para
# registrar en `agent_runs` con qué configuración se admitió el turno; la verdad por
# llamada es la que devuelve el worker (ledger `ai_runs`). La tarea `conversar` usa el
# nivel `equilibrado`.
#
# Secreto que firma (HMAC) el nonce de los sobres de contenido no confiable de cada run.
# Cae a SESSION_SECRET si está vacío; en producción hace falta uno de ≥16 caracteres
# (sin él el chat se declara «no configurado» en vez de arrancar a medias).
AGENT_NONCE_SECRET=
# Límites del run (valores por defecto entre paréntesis; los topes duros no se superan):
#   AGENT_MAX_TOOL_STEPS   vueltas de modelo por turno (8; tope 15)
#   AGENT_RUN_DEADLINE_S   plazo del run completo (180; tope 900)
#   AGENT_MODEL_TIMEOUT_S  plazo de UNA llamada de modelo (45; tope 120)
#   AGENT_MAX_TOKENS       tokens máximos de salida por llamada (2048)
# AGENT_MAX_TOOL_STEPS=
# AGENT_RUN_DEADLINE_S=
# AGENT_MODEL_TIMEOUT_S=
# AGENT_MAX_TOKENS=
# Tamaño máximo de un archivo adjunto al chat, en MB (25; nunca más que MAX_UPLOAD_MB).
# Los adjuntos se suben por POST /api/campanas/[id]/chat/adjuntos, no por una server
# action (Next 15 limita el cuerpo de estas a 1 MB).
# CHAT_ATTACHMENT_MAX_MB=25

# ── Identidad (Épica E2 — Sprint 1) ──────────────────────────────────────────
# Proveedor de identidad conmutable:
#   dev  → selección de usuario sembrado; solo para desarrollo
#   oidc → Google Workspace (NO IMPLEMENTADO: con este valor nadie inicia sesión)
# En PRODUCCIÓN el valor por defecto es CERRADO: sin AUTH_PROVIDER=dev explícito no
# hay login de desarrollo (sin definir, o con un valor desconocido, se cae a `oidc`).
# AUTH_PROVIDER=dev   # opt-in explícito: descomentar SOLO en desarrollo local (nunca en producción)

# Firma de la cookie de sesión. Obligatorio en producción.
SESSION_SECRET=

# OIDC contra el Google Workspace de SmartPR (no implementado: ningún código lee
# estas variables todavía; se conservan como contrato para cuando se conecte).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Dominio autorizado: solo cuentas de este dominio pueden iniciar sesión.
OIDC_ALLOWED_DOMAIN=

# ── Google Drive (Épica E4 — Sprint 2) ───────────────────────────────────────
# DEC-006: cuenta de servicio con delegación a nivel de dominio, restringida al
# Drive de campañas. NUNCA credenciales personales de un usuario.
# Ruta al JSON de la cuenta de servicio; el archivo va fuera del repositorio.
#
# V2 · Fase 5 (Google Sheet de influencers): el worker usa ESTA misma clave con el
# alcance de SOLO LECTURA `spreadsheets.readonly` (sin delegación de dominio ni
# escritura). Comparta cada Sheet de influencers como LECTOR con el correo de la
# cuenta de servicio. Sin esta variable la sincronización falla con
# GOOGLE_NOT_CONFIGURED; la clave nunca se guarda en la base ni en los logs.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
# (no implementado: ningún código lee esta variable; la integración con Drive no existe)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Almacenamiento del original (Épica E4) ───────────────────────────────────
# El original se conserva íntegro y nunca se modifica. En desarrollo va al
# sistema de archivos; en Drive cuando DEC-006 esté conectado.
STORAGE_LOCAL_PATH=./.storage

# ── Storage de derivados (Épica E4 — Sprint 2) ───────────────────────────────
# S3 compatible. Guarda previews, exportaciones y temporales: todo regenerable.
# En local puede usarse MinIO.
# (no implementado: ningún código lee estas variables; hoy solo existe STORAGE_LOCAL_PATH)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Observabilidad (Épica E12 — Sprint 7) ────────────────────────────────────
# Los logs nunca contienen prompts, tokens ni PII (§11.6, caso S-10).
# (no implementado: ningún código lee SENTRY_DSN)
SENTRY_DSN=

# ── Datos personales del KOL (V2 · Fase 8, DEC-013/DEC-049) ──────────────────
# Cifrado a nivel de campo en la aplicación (AES-256-GCM). SIN valor por defecto:
# sin estas variables, guardar o revelar datos personales falla con PII_NOT_CONFIGURED.
# PII_ENCRYPTION_KEYS: «keyId:base64,keyId2:base64»; cada clave son 32 bytes en base64
# (p. ej. `openssl rand -base64 32`). La PRIMERA cifra; las demás solo descifran (rotación).
# PII_INDEX_KEY: clave distinta (≥ 32 bytes, base64) del HMAC que detecta cédulas duplicadas.
# Genere valores propios por entorno; nunca los guarde en el repositorio.
PII_ENCRYPTION_KEYS=
PII_INDEX_KEY=
