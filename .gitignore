# Dependencias
node_modules/
.venv/
__pycache__/
*.py[cod]

# Configuración local — NUNCA se sube (§27: ninguna credencial en Git)
.env
.env.local
.env.*.local
*.pem
*-service-account*.json

# Compilación
dist/
build/
.next/
out/
*.tsbuildinfo

# Pruebas y herramientas
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.eslintcache

# Salidas de Playwright (Sprint 6, Checkpoint 2) — capturas, trazas y el
# reporte HTML de cada corrida, nunca código versionado.
apps/e2e/test-results/
apps/e2e/playwright-report/
apps/e2e/blob-report/

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Skills de agentes instaladas con `npx skills add`.
# No son código del proyecto: `skills-lock.json` las hace reproducibles.
.agents/
.claude/*
!.claude/launch.json

# Material operativo real: contiene datos personales de KOL (DEC-013).
# Se analiza localmente, no se versiona.
/fixtures/real/
*.xlsx
*.pptx
!docs/**/*.xlsx
# Fixture sintético versionado a propósito (pipeline.test.ts, corrección
# posterior al cierre de Sprint 4): nunca material real, generado con
# python-pptx, solo texto de prueba — ver fixtures/pipeline/README.md.
!fixtures/pipeline/*.pptx
.storage/
